# ============================================================
#  Variáveis de ambiente do backend (apps/api)
#  Copie para apps/api/.env e preencha os valores reais.
# ============================================================

# Porta do servidor Express (padrão 3001)
PORT=3001

# Origem permitida para CORS (deixe em branco em desenvolvimento)
CORS_ORIGIN=

# ------------------------------------------------------------
#  n8n — automação de WhatsApp / atendimento
#  O formulário de orçamento envia o lead para este webhook.
#  Deixe em branco para desativar (o lead fica apenas no log).
# ------------------------------------------------------------
N8N_WEBHOOK_URL=

# ------------------------------------------------------------
#  SMTP (envio de e-mail) — opcional
#  Recomendado configurar o envio de e-mail dentro do fluxo n8n.
#  As variáveis abaixo ficam documentadas caso opte por SMTP direto.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ------------------------------------------------------------
#  WhatsApp — número usado nos links (formato 55 + DDD + número)
#  (também configurável no frontend em src/config/contact.js)
# ------------------------------------------------------------
WHATSAPP_NUMBER=5511999999999
